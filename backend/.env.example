# Django core
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-50-chars-minimum
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,yourapp.up.railway.app
CORS_ALLOWED_ORIGINS=https://yourapp.vercel.app
CSRF_TRUSTED_ORIGINS=https://yourapp.vercel.app

# Database (Railway provides this automatically as DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT token lifetimes
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=7

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=WARNING

# Connection pool
CONN_MAX_AGE=60
